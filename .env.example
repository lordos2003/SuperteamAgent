# Ключ агента Superteam Earn (Bearer). Скопируйте файл в .env и вставьте свой ключ.
SUPERTEAM_API_KEY=PASTE_API_KEY_HERE

# Необязательно: базовый URL API (по умолчанию https://superteam.fun)
# SUPERTEAM_API_BASE_URL=https://superteam.fun

# Необязательно: ваш регион для автоматической проверки региональных заданий
# (несколько значений через запятую), например:
# SUPERTEAM_USER_REGION=Ukraine, Europe

# Необязательно: токен GitHub для multi-source поиска (--all-sources).
# Повышает лимиты GitHub API (5000 запросов/час вместо 60) и ускоряет проверку
# первоисточников. Токен только читает публичные данные и никогда не печатается.
# Без токена поиск тоже работает, но проверяется меньше задач за один запуск.
# GITHUB_TOKEN=ghp_your_token_here
